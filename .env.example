# ─────────────────────────────────────────────────────────────────────────────
# idena-node — example environment variables
# Copy this file to .env and adjust values before running docker compose.
# All variables are optional and fall back to the defaults shown here.
# ─────────────────────────────────────────────────────────────────────────────

# SSH user created inside the container (used to connect via SSH tunnel)
IDENA_USER_ACCOUNT_NAME=idenaUser

# SSH password for the account above — CHANGE THIS in production
IDENA_USER_ACCOUNT_PASS=idenaClientPassword

# Docker image name used by docker compose
IDENA_IMAGE_NAME=idena-node:compose-local

# How long (seconds) the idena-node process runs before the container exits
# Default: 86400 (24 h). Use a smaller value for testing.
RUN_TIMEOUT=86400

# Host-side port mappings (the container always listens on 22 / 40405 / 9009)
IDENA_SSH_HOST_PORT=60022
IDENA_P2P_HOST_PORT=40405
IDENA_API_HOST_PORT=9999
